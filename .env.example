# Public URL of this site. Mercado Pago must be able to reach this address.
PUBLIC_BASE_URL=https://your-public-domain.example

# Mercado Pago production or test access token and webhook signing secret.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Email confirmation (Resend).
RESEND_API_KEY=
EMAIL_FROM=

# Generate with: node -p "require('node:crypto').randomBytes(32).toString('base64')"
PIN_ENCRYPTION_KEY=

# Generate with: node -p "require('node:crypto').randomBytes(32).toString('base64url')"
# Keep this private; send it only in the Authorization: Bearer header to the import endpoint.
INVENTORY_ADMIN_TOKEN=

# Optional: use a different Latin GM product page.
LATIN_GM_PRODUCT_URL=https://latingm.com/p/recarga-free-fire-chilez/

PORT=4173
